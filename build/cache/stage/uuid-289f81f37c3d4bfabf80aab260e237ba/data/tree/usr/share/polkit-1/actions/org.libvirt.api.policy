    <message xml:lang="ro">Utilizarea gestionării de alimentare a gazdei necesită autorizare</message>
    <message xml:lang="zh-Hans-CN">使用主机电源管理需要授权</message>
    <message xml:lang="uk">Користування керуванням живленням основної системи потребує уповноваження</message>
    <message xml:lang="sv">Användning av värdens energihantering kräver behörighet</message>
    <message xml:lang="sr-Cyrl">Коришћење управљања напајањем рачунара захтева овлашћење</message>
    <message xml:lang="pt">Usar gestão de energia da máquina anfitriã requer autorização</message>
    <message xml:lang="ko">호스트 전원 관리 사용하기는 권한이 필요합니다</message>
    <message xml:lang="it">L'uso della gestione alimentazione host richiede autorizzazione</message>
    <message xml:lang="es">El empleo de gestión de energía del host requiere autorización</message>
    <message xml:lang="cs">Použití správy napájení hostitele vyžaduje pověření</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>no</allow_active>
    </defaults>
  </action>
  <action id="org.libvirt.api.connect.read">
