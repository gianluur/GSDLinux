<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN" "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Libvirt Project</vendor>
  <vendor_url>https://libvirt.org</vendor_url>
  <action id="org.libvirt.api.connect.detect-storage-pools">
    <description>Detect storage pools</description>
    <description xml:lang="ro">Detectează fondurile de stocare</description>
    <description xml:lang="zh-Hans-CN">检测存储池</description>
    <description xml:lang="uk">Виявити буфери сховища</description>
    <description xml:lang="sv">Upptäck lagringspooler</description>
    <description xml:lang="sr-Cyrl">Откриј складишне базене</description>
    <description xml:lang="pt">Detecta pools de armazenamento</description>
    <description xml:lang="ko">저장소 풀을 탐지합니다</description>
    <description xml:lang="it">Rileva pool di archiviazione</description>
    <description xml:lang="fi">Havaitse varastointivarannot</description>
    <description xml:lang="es">Detectar sondeos de almacenamiento</description>
    <description xml:lang="cs">Zjistit fondy úložiště</description>
    <message>Detecting storage pools requires authorization</message>
    <message xml:lang="ro">Detectarea fondurilor de stocare necesită autorizare</message>
    <message xml:lang="zh-Hans-CN">检测存储池需要授权</message>
    <message xml:lang="uk">Виявлення буферів сховища потребує уповноваження</message>
    <message xml:lang="sv">Upptäckt av lagringspooler kräver behörighet</message>
    <message xml:lang="sr-Cyrl">Откривање складишних базена захтева овлашћење</message>
    <message xml:lang="pt">Detectar pools de armazenamento requer autorização</message>
    <message xml:lang="ko">저장소 풀 탐지하기는 권한이 필요합니다</message>
    <message xml:lang="it">Il rilevamento dei pool di archiviazione richiede l'autorizzazione</message>
    <message xml:lang="fi">varastointivarantojen havaitseminen edellyttää valtuutusta</message>
    <message xml:lang="es">Detección sondeos de almacenaje requieren autorización</message>
    <message xml:lang="cs">Zjišťování fondů úložiště vyžaduje pověření</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>no</allow_active>
    </defaults>
  </action>
  <action id="org.libvirt.api.connect.getattr">
    <description>Access connection</description>
    <description xml:lang="ro">Acces conexiune</description>
    <description xml:lang="zh-Hans-CN">访问连接</description>
    <description xml:lang="uk">З'єднання доступу</description>
    <description xml:lang="sv">Åtkomstanslutning</description>
    <description xml:lang="sr-Cyrl">Приступ вези</description>
    <description xml:lang="pt">Ligação de acesso</description>
    <description xml:lang="ko">접속 연결</description>
    <description xml:lang="it">Accesso connessione</description>
    <description xml:lang="es">Acceder a conexión</description>
    <description xml:lang="en-GB">Access connection</description>
    <description xml:lang="cs">Přistupovat ke spojení</description>
    <message>Accessing the connection requires authorization</message>
    <message xml:lang="ro">Accesarea conexiunii necesită autorizare</message>
    <message xml:lang="zh-Hans-CN">访问连接需要授权</message>
    <message xml:lang="uk">Доступ до з'єднання потребує уповноваження</message>
    <message xml:lang="sv">Åtkomst till anslutningen kräver behörighet</message>
    <message xml:lang="sr-Cyrl">Приступање вези захтева овлашћење</message>
    <message xml:lang="pt">Aceder a ligação requer autorização</message>
    <message xml:lang="ko">연결에 접속하기는 권한이 필요합니다</message>
    <message xml:lang="it">Accesso connessione richiede autorizzazione</message>
    <message xml:lang="es">El acceso a la conexión requiere autorización</message>
    <message xml:lang="en-GB">Accessing the connection requires authorisation</message>
    <message xml:lang="cs">Přístup k připojení vyžaduje ověření se</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
  <action id="org.libvirt.api.connect.interface-transaction">
    <description>Interface transactions</description>
    <description xml:lang="ro">Tranzacții de interfață</description>
    <description xml:lang="zh-Hans-CN">接口事务</description>
    <description xml:lang="uk">Операції з інтерфейсом</description>
    <description xml:lang="sv">Gränssnittstransaktioner</description>
    <description xml:lang="sr-Cyrl">Трансакције интерфејса</description>
    <description xml:lang="pt">Transações de interface</description>
    <description xml:lang="ko">연결장치 연결</description>
    <description xml:lang="it">Transazioni interfaccia</description>
    <description xml:lang="es">Transacciones de interfaz</description>
    <description xml:lang="cs">Transakce rozhraní</description>
    <message>Using interface transactions requires authorization</message>
    <message xml:lang="ro">Utilizarea tranzacțiilor de interfață necesită autorizare</message>
    <message xml:lang="zh-Hans-CN">使用接口事务需要授权</message>
    <message xml:lang="uk">Користування перенесенням інтерфейсів потребує уповноваження</message>
    <message xml:lang="sv">Användning av gränssnittstransaktioner kräver behörighet</message>
    <message xml:lang="sr-Cyrl">Коришћење трансакција интерфејса захтева овлашћење</message>
    <message xml:lang="pt">Usar transações de interface requer autorização</message>
    <message xml:lang="ko">연결장치 연결 사용하기는 권한이 필요합니다</message>
    <message xml:lang="it">L'uso delle transazioni interfaccia richiede autorizzazione</message>
    <message xml:lang="es">El empleo de transacciones de interfaz requiere autorización</message>
    <message xml:lang="cs">Používání transakcí rozhraní vyžaduje pověření</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>no</allow_active>
    </defaults>
  </action>
  <action id="org.libvirt.api.connect.pm-control">
    <description>Use host power management</description>
    <description xml:lang="ro">Utilizează gestionarea alimentării a gazdei</description>
    <description xml:lang="zh-Hans-CN">使用主机电源管理</description>
