    <description xml:lang="ro">Scrie datele volumului de stocare</description>
    <description xml:lang="zh-Hans-CN">写入存储卷数据</description>
    <description xml:lang="uk">Запис даних тому сховища</description>
    <description xml:lang="sv">Skriv lagringsvolymdata</description>
    <description xml:lang="sr-Cyrl">Запиши податке тома складишта</description>
    <description xml:lang="pt">Escrever dados de volume de armazenamento</description>
    <description xml:lang="ko">저장소 볼륨 자료 쓰기</description>
    <description xml:lang="it">Scrivi dati volume storage</description>
    <description xml:lang="es">Escriba datos del volumen de almacenaje</description>
    <description xml:lang="cs">Zapsat data svazku úložiště</description>
    <message>Writing storage volume data requires authorization</message>
    <message xml:lang="ro">Scrierea datelor volumului de stocare necesită autorizare</message>
    <message xml:lang="zh-Hans-CN">写入存储卷数据需要授权</message>
    <message xml:lang="uk">Запис даних тому сховища потребує уповноваження</message>
    <message xml:lang="sv">Skrivning av lagringsvolymdata kräver behörighet</message>
    <message xml:lang="sr-Cyrl">Уписивање података тома складишта захтева овлашћење</message>
    <message xml:lang="pt">Escrever dados de volume de armazenamento requer autorização</message>
    <message xml:lang="ko">저장소 볼륨 자료 쓰기는 권한이 필요합니다</message>
    <message xml:lang="it">Scrivere dati volume storage richiede autorizzazione</message>
    <message xml:lang="es">La escritura de datos del volumen de almacenaje requiere autorización</message>
    <message xml:lang="cs">Zapisování dat svazku úložiště vyžaduje pověření</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>no</allow_active>
    </defaults>
  </action>
  <action id="org.libvirt.api.storage-vol.delete">
    <description>Delete storage volume</description>
    <description xml:lang="ro">Șterge volumul de stocare</description>
