    <description xml:lang="es">Acceder al volumen de almacenamiento</description>
    <description xml:lang="en-GB">Access storage volume</description>
    <description xml:lang="cs">Přistupovat ke svazku úložiště</description>
    <message>Accessing storage volume requires authorization</message>
    <message xml:lang="ro">Accesarea volumului de stocare necesită autorizare</message>
    <message xml:lang="zh-Hans-CN">访问存储卷需要授权</message>
    <message xml:lang="uk">Доступ до тому сховища потребує уповноваження</message>
    <message xml:lang="sv">Åtkomst till lagringsvolym kräver behörighet</message>
    <message xml:lang="sr-Cyrl">Приступање складишном тому захтева овлашћење</message>
    <message xml:lang="pt">Aceder a volume de armazenamento requer autorização</message>
    <message xml:lang="ko">저장소 볼륨에 접속하기는 권한이 필요합니다</message>
    <message xml:lang="it">Accesso volume storage richiede autorizzazione</message>
    <message xml:lang="es">El acceso al volumen de almacenamiento requiere autorización</message>
    <message xml:lang="en-GB">Accessing storage volume requires authorisation</message>
    <message xml:lang="cs">Přístup ke svazku úložiště vyžaduje ověření se</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
