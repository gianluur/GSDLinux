  <action id="org.libvirt.api.storage-vol.getattr">
    <description>Access storage volume</description>
    <description xml:lang="ro">Acces volum de stocare</description>
    <description xml:lang="zh-Hans-CN">访问存储卷</description>
    <description xml:lang="uk">Том сховища доступу</description>
